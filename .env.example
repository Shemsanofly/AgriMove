# Africa's Talking credentials (sandbox or production)
AT_USERNAME=sandbox
AT_API_KEY=your_sandbox_api_key_here

# Voice IVR — your AT virtual phone number (international format, e.g. +255...)
AT_VOICE_NUMBER=+255XXXXXXXXX

# Human agent number for menu option 4 (optional)
AT_AGENT_NUMBER=+255XXXXXXXXX

# Public HTTPS base URL for voice webhooks (your ngrok or production domain)
# Example: https://abc123.ngrok-free.app
VOICE_BASE_URL=
